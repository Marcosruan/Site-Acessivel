generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String   
  summary   String?  
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos    Video[]
  exercises Exercise[]

  @@map("articles")
}

model Video {
  id          String   @id @default(uuid())
  title       String
  url         String
  description String?
  order       Int      @default(0)

  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("videos")
}

model Exercise {
  id            String   @id @default(uuid())
  prompt        String  
  explanation   String?  
  order         Int      @default(0)

  articleId     String
  article       Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)

  alternatives  Alternative[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("exercises")
}

model Alternative {
  id         String   @id @default(uuid())
  text       String   
  isCorrect  Boolean  @default(false)
  order      Int      @default(0) 

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@map("alternatives")
}
